{
  "name": "@visual-yaml/vscode",
  "displayName": "visual-yaml",
  "description": "(Beta) Visual YAML editor with tree view, schema support, and search",
  "version": "0.0.3",
  "license": "Apache-2.0",
  "publisher": "visual-yaml",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onCustomEditor:visualYaml.editor",
    "onView:visualYaml.panel"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "visualYaml.editor",
        "displayName": "visual-yaml",
        "selector": [
          {
            "filenamePattern": "*.yaml"
          },
          {
            "filenamePattern": "*.yml"
          }
        ],
        "priority": "option"
      }
    ],
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "visualYaml.panel",
          "name": "visual-yaml",
          "when": "resourceLangId == yaml"
        }
      ]
    },
    "commands": [
      {
        "command": "visualYaml.openWithVisualYaml",
        "title": "Open with visual-yaml"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs --production",
    "dev": "node esbuild.mjs --watch",
    "check-types": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@visual-yaml/core": "workspace:*",
    "@visual-yaml/react": "workspace:*",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "5.9.3"
  }
}
