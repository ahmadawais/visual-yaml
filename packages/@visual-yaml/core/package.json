{
  "name": "@visual-yaml/core",
  "version": "0.3.1",
  "license": "Apache-2.0",
  "description": "Headless core for visual-yaml — the visual YAML editor. Schema-aware, embeddable, extensible.",
  "keywords": [
    "yaml",
    "editor",
    "tree",
    "schema",
    "visual"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check-types": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "5.9.3"
  }
}
